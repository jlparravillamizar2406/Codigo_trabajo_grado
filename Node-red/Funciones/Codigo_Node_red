        "id": "084e10b8a72ec670",
        "type": "function",
        "z": "951e2f7cf9ec780f",
        "name": "Func Promedio",
        "func": "// -------------------------------------------------\n// BUFFER\n// -------------------------------------------------\nif (!context.buffer) {\n    context.buffer = [];\n}\n\ncontext.buffer.push(msg.payload);\n\n// -------------------------------------------------\n// PROCESAMIENTO CUANDO HAY 15 MUESTRAS\n// -------------------------------------------------\nif (context.buffer.length === 15) {\n\n    let result = {};\n\n    let keys = [\n        \"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\",\n        \"I\", \"J\", \"K\", \"L\", \"R\", \"S\", \"T\", \"U\", \"V\", \"W\",\n        \"Pressure\", \"TempDS\"\n    ];\n\n    keys.forEach(key => {\n\n        let values = context.buffer\n            .map(sample => sample[key])\n            .filter(v => typeof v === \"number\" && !isNaN(v));\n\n        // ⚠️ Si no hay datos válidos, se ignora\n        if (values.length === 0) return;\n\n        // -------------------------------------------------\n        // 🔥 MEDIANA (igual que en Python)\n        // -------------------------------------------------\n        values.sort((a, b) => a - b);\n\n        let mid = Math.floor(values.length / 2);\n\n        let median = (values.length % 2 !== 0)\n            ? values[mid]\n            : (values[mid - 1] + values[mid]) / 2;\n\n        result[key] = median;\n    });\n\n    // Limpiar buffer\n    context.buffer = [];\n\n    // -------------------------------------------------\n    // EXPERIMENTO\n    // -------------------------------------------------\n    let experiment = global.get(\"experiment\") || \"exp2\";\n\n    // -------------------------------------------------\n    // VALIDACIÓN FINAL (evita enviar datos incompletos)\n    // -------------------------------------------------\n    let required = [\n        \"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\",\n        \"I\", \"J\", \"K\", \"L\", \"R\", \"S\", \"T\", \"U\", \"V\", \"W\",\n        \"TempDS\", \"Pressure\"\n    ];\n\n    for (let k of required) {\n        if (result[k] === undefined || isNaN(result[k])) {\n            node.warn(\"❌ Falta dato procesado: \" + k);\n            return null;\n        }\n    }\n\n    // -------------------------------------------------\n    // MENSAJE FINAL\n    // -------------------------------------------------\n    let msg_espectro = {\n        measurement: \"espectro_od\",\n        payload: {\n            experiment: experiment,\n\n            A: result.A,\n            B: result.B,\n            C: result.C,\n            D: result.D,\n            E: result.E,\n            F: result.F,\n            G: result.G,\n            H: result.H,\n\n            I: result.I,\n            J: result.J,\n            K: result.K,\n            L: result.L,\n\n            R: result.R,\n            S: result.S,\n            T: result.T,\n            U: result.U,\n            V: result.V,\n            W: result.W,\n\n            TempDS: result.TempDS,\n            Pressure: result.Pressure\n        }\n    };\n\n    return [null, msg_espectro, null];\n}\n\n// -------------------------------------------------\nreturn null;",
