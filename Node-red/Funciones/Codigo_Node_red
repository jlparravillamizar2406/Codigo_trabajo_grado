    {
        "id": "79f24b3e9f0e7286",
        "type": "function",
        "z": "951e2f7cf9ec780f",
        "name": "Modelo OD",
        "func": "let d = msg.payload;\n\n// -----------------------------\n// VALIDACIÓN\n// -----------------------------\nif (!d) return null;\n\nlet bands = [\n    \"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\",\n    \"I\", \"J\", \"K\", \"L\", \"R\", \"S\", \"T\", \"U\", \"V\", \"W\"\n];\n\nfor (let k of bands) {\n    if (d[k] === undefined || isNaN(d[k])) {\n        node.warn(\"❌ Falta dato: \" + k);\n        return null;\n    }\n}\n\n// -----------------------------\n// FEATURES DERIVADAS\n// -----------------------------\nlet B_minus_D = d.B - d.D;\nlet C_minus_E = d.C - d.E;\nlet H_minus_I = d.H - d.I;\n\nlet B_plus_D = d.B + d.D;\nlet C_plus_E = d.C + d.E;\n\n// -----------------------------\n// 🔥 MODELO (ESTABLE)\n// -----------------------------\nlet OD_raw =\n    -126.290661\n    + (-1.565949 * d.A)\n    + (0.015876 * d.B)\n    + (-0.011128 * d.C)\n    + (-0.016304 * d.D)\n    + (0.060655 * d.E)\n    + (-0.179039 * d.F)\n    + (-0.221276 * d.G)\n    + (0.029210 * d.H)\n    + (0.091099 * d.I)\n    + (-0.008144 * d.J)\n    + (0.224470 * d.K)\n    + (0.394721 * d.L)\n    + (0.009780 * d.R)\n    + (-0.007076 * d.S)\n    + (0.081659 * d.T)\n    + (-0.016944 * d.U)\n    + (0.052256 * d.V)\n    + (-0.055142 * d.W)\n    + (0.032180 * B_minus_D)\n    + (-0.071783 * C_minus_E)\n    + (-0.061889 * H_minus_I)\n    + (-0.000427 * B_plus_D)\n    + (0.049527 * C_plus_E);\n\n// Guardar último valor\nflow.set(\"ultimo_OD_raw\", OD_raw);\n\n// -----------------------------\n// CALIBRACIÓN POR OFFSET\n// -----------------------------\nlet offset = flow.get(\"offset\") || 0;\nlet OD_final = OD_raw + offset;\n\n// -----------------------------\n// PROTECCIÓN FÍSICA\n// -----------------------------\nif (OD_final < 0) OD_final = 0;\nif (OD_final > 20) OD_final = 20;\n\n// -----------------------------\n// 🔥 DEBUG COMPLETO (CLAVE)\n// -----------------------------\nnode.warn(\n    \"📊 OD RAW: \" + OD_raw.toFixed(3) +\n    \" | OFFSET: \" + offset.toFixed(3) +\n    \" | OD FINAL: \" + OD_final.toFixed(3)\n);\n\n// -----------------------------\n// OUTPUT\n// -----------------------------\nmsg.measurement = \"od_model\";\n\nmsg.payload = {\n    OD_model: OD_final,\n    OD_raw_model: OD_raw,\n    offset: offset\n};\n\nreturn msg;",
